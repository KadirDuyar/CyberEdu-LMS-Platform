# ==============================================================================
# CyberEdu LMS — Çevre Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env olarak kopyalayıp kendi anahtarlarınızı giriniz.
# ==============================================================================

# Supabase Proje Bilgileri (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Google Gemini API Anahtarı (Google AI Studio -> Get API key)
VITE_GEMINI_API_KEY=AIzaSy...your-gemini-api-key

# Groq Cloud API Anahtarı (console.groq.com -> API Keys - Llama 3 Ultra Hızlı)
VITE_GROQ_API_KEY=gsk_...your-groq-api-key

