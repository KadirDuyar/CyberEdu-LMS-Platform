# ==============================================================================
# CyberEdu LMS — Çevre Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env.local olarak kopyalayıp kendi anahtarlarınızı giriniz.
# ==============================================================================

# ─── 1. İstemci Tarafı Değişkenleri (Browser Bundle'a dahil olur) ──────────────
# Supabase Proje Bilgileri (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# ─── 2. Sunucu Tarafı Güvenli AI Değişkenleri (ASLA istemciye gönderilmez) ─────
# Vercel Serverless Function (/api/ai) ve Vite yerel dev proxy tarafından okunur.
# Vercel Dashboard -> Project Settings -> Environment Variables alanına ekleyiniz.
GEMINI_API_KEY=AIzaSy...your-gemini-api-key
GROQ_API_KEY=gsk_...your-groq-api-key

# İsteğe bağlı model yapılandırmaları
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
