# CyberEdu LMS — Environment Variables Example
# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri doldur.
# ÖNEMLİ: .env.local dosyasını ASLA git'e commit etme!

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI (AI Mentor için)
# NOT: Production'da bu key bir Supabase Edge Function içinde saklanmalıdır.
VITE_GEMINI_API_KEY=your-gemini-api-key
